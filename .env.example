# --- OpenAI (used for query rewriting + answer generation) ---
OPENAI_API_KEY=sk-...
HRAG_GEN_MODEL=gpt-4o
HRAG_REWRITE_MODEL=gpt-4o-mini

# --- Embedding + reranker models (HuggingFace IDs) ---
HRAG_EMBED_MODEL=BAAI/bge-large-en-v1.5
HRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval hyperparameters (paper Table 1) ---
HRAG_HYBRID_ALPHA=0.7      # 0.7 = 70% dense, 30% sparse
HRAG_TOP_K_CHILDREN=50     # initial candidates
HRAG_TOP_N_PARENTS=5       # parents passed to generator
HRAG_RANK_PARENTS=true     # child-first ranking with parent aggregation

# --- Chunking (paper §3.5) ---
HRAG_CHUNK_SENTENCES=3
HRAG_CHUNK_STRIDE=2

# --- Storage paths ---
HRAG_CHROMA_PATH=./.hrag_store/chroma
HRAG_DOCSTORE_PATH=./.hrag_store/parents.sqlite
HRAG_SESSION_PATH=./.hrag_store/sessions.sqlite
HRAG_BM25_PATH=./.hrag_store/bm25.pkl
